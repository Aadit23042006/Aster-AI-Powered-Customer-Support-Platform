# ============================================================
# ASTER & ROW SUPPORT AGENT - FINAL .env.example
# ============================================================
# Setup (one time):
#   1. cp .env.example .env
#   2. Replace ONLY GEMINI_API_KEY with your real key
#   3. docker compose up --build
#
# Do NOT edit this file per test. Tests override settings
# themselves (USE_MOCK_LLM, SELF_SIGNUP_ENABLED, AUTH_SECRET,
# RATE_LIMIT_ENABLED are set inside tests_web/conftest.py).
# NEVER commit .env with a real key.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_ENV=development
DEBUG=false

# ------------------------------------------------------------
# POSTGRESQL (Docker service name: postgres)
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aster_row
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/aster_row
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/aster_row_test

# ------------------------------------------------------------
# REDIS / CELERY (Docker service name: redis)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------
# GOOGLE GEMINI  (the ONLY value you must replace)
# ------------------------------------------------------------
GEMINI_API_KEY=<YOUR_NEW_GEMINI_API_KEY>

# Primary / fallback chat models
CHAT_MODEL=gemini-2.5-flash
CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite

# Embeddings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ------------------------------------------------------------
# LLM RETRY / FAILOVER
# ------------------------------------------------------------
LLM_MAX_ATTEMPTS_PER_MODEL=2
LLM_RETRY_INITIAL_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=2.0
LLM_FAILOVER_HUMAN_HANDOFF=1

# ------------------------------------------------------------
# MODEL ROUTER
# ------------------------------------------------------------
MODEL_ROUTER_ENABLED=true
MODEL_ROUTER_RULES_JSON={"simple_question":"gemini-3.5-flash-lite","complex_question":"gemini-3.5-flash-lite","classification":"gemini-3.5-flash-lite","summarization":"gemini-3.5-flash-lite","retrieval":"gemini-3.5-flash-lite","tool_call":"gemini-3.5-flash-lite"}

# ------------------------------------------------------------
# REAL LLM (0 = real Gemini, 1 = deterministic mock)
# ------------------------------------------------------------
USE_MOCK_LLM=0

# ------------------------------------------------------------
# RETRIEVAL / RAG
# ------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.45
RETRIEVAL_SEMANTIC_WEIGHT=0.65
RETRIEVAL_KEYWORD_WEIGHT=0.35
RETRIEVAL_KEYWORD_SATURATION_K=2.5
RETRIEVAL_HYBRID_MIN_SCORE=0.22
RAG_CITATIONS_ENABLED=true
MAX_HISTORY_TURNS=6

# ------------------------------------------------------------
# AI RESPONSE QUALITY
# ------------------------------------------------------------
QUALITY_GROUNDING_ALLOW=0.75
QUALITY_GROUNDING_HIGH=0.85
QUALITY_GROUNDING_MEDIUM=0.65
QUALITY_RETRY_TOP_K_MULTIPLIER=2
QUALITY_CLARIFY_MAX_WORDS=4

# ------------------------------------------------------------
# VOICE / IMAGE / LANGUAGE
# ------------------------------------------------------------
VOICE_ENABLED=true
VOICE_PROVIDER=browser
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_FILE_SIZE_MB=10
IMAGE_SUPPORT_ENABLED=false
MAX_IMAGE_SIZE_MB=10
MULTILINGUAL_ENABLED=true
DEFAULT_LANGUAGE=en

# ------------------------------------------------------------
# AUTHENTICATION / SESSIONS
# ------------------------------------------------------------
# Local development secret (same value docker-compose uses by default).
# Change it for any real deployment.
AUTH_SECRET=change-me-to-a-long-random-development-secret-please-change
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_DAYS=365
SESSION_TTL_SECONDS=1800

# ------------------------------------------------------------
# ACCOUNT ACCESS
# ------------------------------------------------------------
SELF_SIGNUP_ENABLED=true
LOGIN_ALLOWLIST_ENABLED=false
ALLOWED_LOGIN_EMAILS=admin@example.com,support@example.com,customer@example.com

# ------------------------------------------------------------
# API KEYS / WEBHOOKS
# ------------------------------------------------------------
API_KEYS_ENABLED=true
WEBHOOKS_ENABLED=true
WEBHOOK_MAX_RETRIES=3
# Leave EMPTY for local use (a safe key is derived automatically).
# If you set it, it must be a valid Fernet key.
WEBHOOK_ENCRYPTION_KEY=

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_COUNT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AI_CHAT_COUNT=30
RATE_LIMIT_AI_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_COUNT=120
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60

# ------------------------------------------------------------
# NOTIFICATIONS / WORKERS
# ------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
EMAIL_PROVIDER=console
WORKERS_ENABLED=true

# ------------------------------------------------------------
# SECURITY / MONITORING
# ------------------------------------------------------------
PII_REDACTION_ENABLED=true
MONITORING_ENABLED=true
ERROR_TRACKING_ENABLED=false

# ------------------------------------------------------------
# PLATFORM FEATURES
# ------------------------------------------------------------
MULTI_TENANT_ENABLED=true
KB_VERSIONING_ENABLED=true
AI_AGENT_ACTIONS_ENABLED=true
AI_ACTION_APPROVAL_REQUIRED=true
RECOMMENDATIONS_ENABLED=true
RECOMMENDATION_INTELLIGENCE_ENABLED=true

# ------------------------------------------------------------
# AI MODEL PRICING (leave empty: cost stays "unavailable")
# ------------------------------------------------------------
AI_MODEL_PRICING_JSON=

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
